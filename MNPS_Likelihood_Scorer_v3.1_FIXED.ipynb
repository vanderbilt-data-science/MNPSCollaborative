        "if display_cols:\n",
        "    print(input_data['classifications'][display_cols].head())",
        "\n\n# ============================================================================\n# FIX v3.1: Merge job descriptions with classifications\n# ============================================================================\nprint(\"\\n\ud83d\udd27 FIX v3.1: Merging job descriptions...\")\n\nif 'job_descriptions' in input_data and 'classifications' in input_data:\n    jd_df = input_data['job_descriptions'].copy()\n    \n    # Create full JD text from all relevant columns\n    jd_cols = []\n    for col in ['Position Summary', 'Essential Functions', 'Knowledge, Skills and Abilities']:\n        if col in jd_df.columns:\n            jd_cols.append(col)\n    \n    if jd_cols:\n        jd_df['full_job_description'] = jd_df[jd_cols].fillna('').agg(' '.join, axis=1).str.strip()\n    else:\n        jd_df['full_job_description'] = ''\n    \n    # Merge with classifications\n    classifications_df = input_data['classifications'].copy()\n    \n    if 'job_title_original' in classifications_df.columns and 'Job Title' in jd_df.columns:\n        classifications_df = classifications_df.merge(\n            jd_df[['Job Title', 'full_job_description']], \n            left_on='job_title_original',\n            right_on='Job Title',\n            how='left',\n            suffixes=('', '_jd')\n        )\n        \n        jd_present = classifications_df['full_job_description'].notna().sum()\n        jd_missing = classifications_df['full_job_description'].isna().sum()\n        \n        print(f\"  \u2705 Merge complete: {jd_present}/{len(classifications_df)} with JD text\")\n        if jd_missing > 0:\n            print(f\"     \u26a0\ufe0f  {jd_missing} records missing JD\")\n        \n        # Update input_data\n        input_data['classifications'] = classifications_df\n    else:\n        print(\"  \u26a0\ufe0f  Could not find matching columns for merge\")\nelse:\n    print(\"  \u26a0\ufe0f  Required data not found\")"
      ],
