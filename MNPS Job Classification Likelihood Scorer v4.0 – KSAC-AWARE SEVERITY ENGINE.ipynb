#@title 6️⃣ Build KSAC Embedding Engine { display-mode: "form" }
def clean_salary(s):
    if pd.isna(s): return 0
    return float(re.sub(r'[^\d.]', '', str(s)) or 0)

def preprocess_salary_data(df):
    df = df.copy()
    df.columns = df.columns.str.strip()
    for col in ['Min Annual Salary', 'Average Annual Salary', 'Max Annual Salary']:
        if col in df.columns:
            df[col] = df[col].apply(clean_salary)
    df['Major Role Grouping'] = df['Major Role Grouping'].str.strip()
    return df

# Build role-to-KSAC map
ksac_df = resource_data['ksacs'].copy()
ksac_df['Role'] = ksac_df['Role'].str.strip()
ksac_df['KSAC_Text'] = ksac_df['KSAC_Text'].fillna('').str.lower()
role_ksac_map = ksac_df.groupby('Role')['KSAC_Text'].apply(' '.join).to_dict()
all_roles = list(role_ksac_map.keys())

# Fit TF-IDF on all KSAC texts
tfidf = TfidfVectorizer(stop_words='english', ngram_range=(1,2))
ksac_corpus = [role_ksac_map[r] for r in all_roles]
tfidf_matrix = tfidf.fit_transform(ksac_corpus)
role_to_idx = {role: i for i, role in enumerate(all_roles)}

print(f"✅ Built KSAC embedding space for {len(all_roles)} roles")
================================================================================
#@title 7️⃣ Define v4.0 Scoring Functions { display-mode: "form" }
def get_ksac_similarity(predicted_role):
    if pd.isna(predicted_role):
        return 0.0, "Missing role"
    pred = str(predicted_role).strip()
    if pred not in role_to_idx:
        return 0.0, f"'{pred}' not in KSAC role list"
    pred_vec = tfidf_matrix[role_to_idx[pred]]
    similarities = cosine_similarity(pred_vec, tfidf_matrix).flatten()
    max_sim = similarities.max()
    top_idx = np.argmax(similarities)
    top_role = all_roles[top_idx]
    reason = f"Max similarity: {max_sim:.3f} to '{top_role}'"
    return float(max_sim), reason

def calculate_salary_impact_v4(predicted_role, similarity_score):
    if pd.isna(predicted_role):
        return 0.5, "Missing role", 0
    role = str(predicted_role).strip()
    sal_df = resource_data['salary_data']
    match = sal_df[sal_df['Major Role Grouping'].str.strip() == role]
    if match.empty:
        return 0.5, f"No salary for '{role}'", 0
    avg_sal = match['Average Annual Salary'].iloc[0]
    max_sal = sal_df['Max Annual Salary'].max()
    min_sal = sal_df['Min Annual Salary'].min()
    norm_sal = (avg_sal - min_sal) / (max_sal - min_sal) if max_sal > min_sal else 0.5
    # ⚠️ MODIFIED: Penalty scales with dissimilarity
    error_severity = (1 - similarity_score) * norm_sal
    score = 1.0 - error_severity
    band = "Exec" if avg_sal >= 100000 else "Senior" if avg_sal >= 80000 else "Mid" if avg_sal >= 60000 else "Entry"
    return score, f"{band} (${avg_sal:,.0f}) × dissimilarity {1-similarity_score:.2f}", avg_sal

def calculate_time_impact_v4(similarity_score):
    base_hours = resource_data['time_to_correct'].iloc[0]['Average']  # e.g., 40
    error_severity = 1 - similarity_score
    adj_hours = base_hours * (1 + error_severity)
    time_score = 1.0 - min(1.0, adj_hours / 80)
    return time_score, adj_hours

def score_justification_quality_v4(just):
    if not just or pd.isna(just):
        return 0.1
    text = str(just).lower()
    certainty = sum(1 for w in ['clearly', 'definitively', 'demonstrates', 'requires'] if w in text)
    hedge = sum(1 for w in ['could', 'might', 'possibly', 'unclear'] if w in text)
    raw = 0.2 + 0.1*certainty - 0.15*hedge
    return min(0.5, max(0.1, raw))

def calculate_confidence_v4(classification, sub_group, justification, job_description):
    # Reuse logic from earlier response (simplified here for brevity)
    # ... (same as in prior v4.0 confidence function)
    return {
        'confidence_score': 0.7,
        'confidence_reasoning': "MODERATE (0.70). Weak: subgroup_clarity.",
        'is_borderline': 0.7 < CONFIDENCE_THRESHOLD
    }
