#@title 8️⃣ Run v4.0 KSAC-Aware Scoring { display-mode: "form" }
resource_data['salary_data'] = preprocess_salary_data(resource_data['salary_data'])

results = []
for idx, row in input_data['classifications'].iterrows():
    classification = row.get('major_role_group', '')
    sub_group = row.get('minor_sub_group', '')
    justification = row.get('grouping_justification', '')
    job_title = row.get('new_job_title', 'Unknown')
    job_desc = row.get('job_description', '')
    
    # 🔑 NEW: KSAC similarity (gradient)
    sim_score, sim_reason = get_ksac_similarity(classification)
    
    # 🔑 NEW: Salary impact modulated by dissimilarity
    sal_score, sal_reason, sal_amt = calculate_salary_impact_v4(classification, sim_score)
    
    # 🔑 NEW: Time impact scales with error severity
    time_score, adj_hours = calculate_time_impact_v4(sim_score)
    
    # Subgroup & justification
    subgroup_score = 0.8 if sub_group in ['I','II','III'] else 0.5
    just_score = score_justification_quality_v4(justification)
    
    # Composite
    composite = (
        weights['similarity'] * sim_score +
        weights['salary'] * sal_score +
        weights['time'] * time_score +
        weights['subgroup'] * subgroup_score +
        weights['justification'] * just_score
    )
    
    # Confidence (simplified)
    conf_info = calculate_confidence_v4(classification, sub_group, justification, job_desc)
    
    # Likelihood
    def composite_to_likelihood(c):
        if c <= 0.2: return c * 5
        elif c <= 0.88: return 1.0 + ((c - 0.2) / 0.68) * 3.0
        elif c <= 0.94: return 4.0 + ((c - 0.88) / 0.06) * 1.0
        else: return 5.0
    likelihood = composite_to_likelihood(composite)
    perf = "Superhuman" if likelihood >= 4.75 else "Excellent" if likelihood >= 4.5 else "Human-level" if likelihood >= 4.0 else "Below Human"
    
    results.append({
        'job_title': job_title,
        'classification': classification,
        'ksac_similarity': sim_score,
        'salary_amount': sal_amt,
        'adjusted_correction_hours': adj_hours,
        'likelihood_score': likelihood,
        'composite_score': composite,
        'confidence_score': conf_info['confidence_score'],
        'performance_category': perf,
        'is_borderline': conf_info['is_borderline']
    })

results_df = pd.DataFrame(results)
print(f"✅ Analyzed {len(results_df)} records")
print(f"📊 Avg KSAC Similarity: {results_df['ksac_similarity'].mean():.3f}")
print(f"📊 Avg Likelihood: {results_df['likelihood_score'].mean():.2f}")
results_df.to_csv(os.path.join(run_results_path, 'v4_ksac_aware_scores.csv'), index=False)
